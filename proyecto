<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Galería de Animaciones — Métodos Matemáticos</title>
  <style>
    body { font-family: "Segoe UI", sans-serif; background:#0e0e0e; color:#f0f0f0; margin:0; }
    h1 { text-align:center; padding:20px 12px; }
    .gallery { display:flex; flex-wrap:wrap; justify-content:center; gap:20px; padding:20px; }
    .item { background:#1c1c1c; border-radius:12px; padding:12px; max-width:420px; box-shadow:0 0 10px rgba(255,255,255,.08); }
    .item img { width:100%; height:auto; border-radius:6px; cursor:pointer; transition:transform .2s ease; }
    .item img:hover { transform:scale(1.05); }
    .caption { margin-top:8px; font-weight:600; text-align:center; }
    footer { text-align:center; margin:24px 0; color:#aaa; font-size:.9em; }

    /* ===== Lightbox puro CSS con :target ===== */
    .overlay {
      position: fixed;
      inset: 0;                 /* top/right/bottom/left:0 */
      background: rgba(0,0,0,.85);
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease;
      z-index: 9999;
    }
    .overlay:target {
      opacity: 1;
      pointer-events: auto;
    }
    .overlay img {
      max-width: 95vw;
      max-height: 95vh;
      border-radius: 12px;
      box-shadow: 0 0 20px rgba(255,255,255,.25);
    }
    .close {
      position: absolute;
      top: 18px;
      right: 26px;
      color: #fff;
      font-size: 2rem;
      text-decoration: none;
      line-height: 1;
    }
  </style>
</head>
<body>
  <h1>📽️ Galería de Animaciones — Métodos Matemáticos</h1>

  <div class="gallery">
    <div class="item">
      <!-- OJO: el espacio del archivo va como %20 -->
      <a href="#regresion"><img src="gifs/regresion_diodo_ajuste%20(1).gif" alt="Regresión — Ajuste de Shockley"></a>
      <div class="caption">🔄 Regresión — Ajuste de Shockley</div>
    </div>

    <div class="item">
      <a href="#interp"><img src="gifs/interpolacion_ventana%20(1).gif" alt="Interpolación — Ventana deslizante"></a>
      <div class="caption">🎚️ Interpolación — Ventana deslizante</div>
    </div>

    <div class="item">
      <a href="#fdtd"><img src="gifs/fdtd_propagacion%20(1).gif" alt="FDTD — Propagación 1D"></a>
      <div class="caption">🌊 FDTD — Propagación 1D</div>
    </div>
  </div>

  <!-- Overlays (uno por imagen) -->
  <div id="regresion" class="overlay">
    <a class="close" href="#">&times;</a>
    <img src="gifs/regresion_diodo_ajuste%20(1).gif" alt="">
  </div>

  <div id="interp" class="overlay">
    <a class="close" href="#">&times;</a>
    <img src="gifs/interpolacion_ventana%20(1).gif" alt="">
  </div>

  <div id="fdtd" class="overlay">
    <a class="close" href="#">&times;</a>
    <img src="gifs/fdtd_propagacion%20(1).gif" alt="">
  </div>

  <footer>© 2025 - Proyecto de Métodos Matemáticos</footer>
</body>
</html>
