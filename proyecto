<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Galería de Animaciones — Métodos Matemáticos</title>
  <style>
    body {
      font-family: "Segoe UI", sans-serif;
      background-color: #0e0e0e;
      color: #f0f0f0;
      text-align: center;
      margin: 0;
      padding: 0;
    }
    h1 {
      padding-top: 20px;
    }
    .gallery {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      padding: 20px;
    }
    .item {
      background: #1c1c1c;
      border-radius: 10px;
      padding: 10px;
      max-width: 400px;
      box-shadow: 0 0 10px rgba(255,255,255,0.1);
    }
    .item img {
      max-width: 100%;
      border-radius: 5px;
    }
    .caption {
      margin-top: 8px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>📽️ Galería de Animaciones — Métodos Matemáticos</h1>
  <div class="gallery">
    <div class="item">
      <img src="regresion_diodo_ajuste.gif" alt="Regresión">
      <div class="caption">🔄 Regresión — Ajuste de Shockley</div>
    </div>
    <div class="item">
      <img src="interpolacion_ventana.gif" alt="Interpolación">
      <div class="caption">🎚️ Interpolación — Ventana deslizante</div>
    </div>
    <div class="item">
      <img src="fdtd_propagacion.gif" alt="FDTD">
      <div class="caption">🌊 FDTD — Propagación 1D</div>
    </div>
  </div>
</body>
</html>
